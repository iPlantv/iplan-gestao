<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>iPlan — Tecnologia para Vendedores de Consórcio</title>
  <meta name="description" content="Controle suas comissões parceladas, acompanhe seus clientes e nunca mais perca uma parcela. O sistema feito para vendedores de consórcio." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:   #060d1a;
      --navy2:  #0a1628;
      --navy3:  #0f2540;
      --navy4:  #1a3a5c;
      --blue:   #1e6bc4;
      --blue2:  #4ab3f4;
      --blue3:  #7dd3fc;
      --cyan:   #06b6d4;
      --green:  #10b981;
      --amber:  #f59e0b;
      --red:    #ef4444;
      --white:  #ffffff;
      --gray:   #f0f4f8;
      --text:   #e2e8f0;
      --text2:  #94a3b8;
      --text3:  #64748b;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Sora', sans-serif;
      background: var(--navy);
      color: var(--text);
      overflow-x: hidden;
    }

    /* ── NOISE TEXTURE ── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
    }

    /* ── NAV ── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(6,13,26,0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(74,179,244,0.08);
    }
    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .nav-logo-icon {
      width: 36px; height: 36px;
      background: linear-gradient(135deg, var(--navy4), var(--blue));
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px;
    }
    .nav-logo-text { font-size: 18px; font-weight: 700; color: var(--white); letter-spacing: -0.3px; }
    .nav-links { display: flex; align-items: center; gap: 2rem; }
    .nav-links a { color: var(--text2); text-decoration: none; font-size: 14px; font-weight: 500; transition: color .2s; }
    .nav-links a:hover { color: var(--white); }
    .nav-cta {
      background: var(--blue);
      color: var(--white);
      padding: 10px 22px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: all .2s;
      border: none;
      cursor: pointer;
    }
    .nav-cta:hover { background: #1a5fa8; transform: translateY(-1px); }

    /* ── HERO ── */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 8rem 2rem 4rem;
      position: relative;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 50% at 50% -10%, rgba(30,107,196,0.25) 0%, transparent 60%),
        radial-gradient(ellipse 50% 40% at 80% 80%, rgba(74,179,244,0.08) 0%, transparent 50%),
        radial-gradient(ellipse 40% 30% at 10% 60%, rgba(6,182,212,0.06) 0%, transparent 50%);
    }
    .hero-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(74,179,244,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(74,179,244,0.04) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 0%, transparent 80%);
    }
    .hero-content { position: relative; z-index: 1; max-width: 800px; }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(30,107,196,0.15);
      border: 1px solid rgba(74,179,244,0.25);
      color: var(--blue3);
      padding: 6px 16px;
      border-radius: 99px;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 1.75rem;
      animation: fadeup .6s ease both;
    }
    .hero-badge-dot { width: 6px; height: 6px; background: var(--cyan); border-radius: 50%; animation: pulse 2s infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.5)} }
    .hero h1 {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -2px;
      color: var(--white);
      margin-bottom: 1.5rem;
      animation: fadeup .6s .1s ease both;
    }
    .hero h1 span {
      background: linear-gradient(135deg, var(--blue2), var(--cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero p {
      font-size: clamp(1rem, 2vw, 1.2rem);
      color: var(--text2);
      line-height: 1.7;
      max-width: 580px;
      margin: 0 auto 2.5rem;
      animation: fadeup .6s .2s ease both;
    }
    .hero-btns {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
      animation: fadeup .6s .3s ease both;
    }
    .btn-hero {
      padding: 14px 32px;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      font-family: 'Sora', sans-serif;
      cursor: pointer;
      text-decoration: none;
      transition: all .2s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: none;
    }
    .btn-hero-primary {
      background: linear-gradient(135deg, var(--blue), #1a5fa8);
      color: var(--white);
      box-shadow: 0 0 30px rgba(30,107,196,0.4);
    }
    .btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 0 40px rgba(30,107,196,0.6); }
    .btn-hero-secondary {
      background: rgba(255,255,255,0.05);
      color: var(--text);
      border: 1px solid rgba(255,255,255,0.1);
    }
    .btn-hero-secondary:hover { background: rgba(255,255,255,0.08); transform: translateY(-2px); }
    .hero-scroll {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      color: var(--text3);
      font-size: 12px;
      animation: bounce 2s infinite;
    }
    @keyframes bounce { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(6px)} }

    @keyframes fadeup {
      from { opacity:0; transform:translateY(20px); }
      to { opacity:1; transform:translateY(0); }
    }

    /* ── MOCKUP ── */
    .mockup-section {
      padding: 2rem 2rem 6rem;
      display: flex;
      justify-content: center;
      position: relative;
    }
    .mockup-wrap {
      max-width: 900px;
      width: 100%;
      position: relative;
    }
    .mockup-glow {
      position: absolute;
      inset: -40px;
      background: radial-gradient(ellipse at 50% 50%, rgba(30,107,196,0.15) 0%, transparent 70%);
      pointer-events: none;
    }
    .mockup {
      background: var(--navy2);
      border: 1px solid rgba(74,179,244,0.15);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 40px 80px rgba(0,0,0,0.5);
      position: relative;
    }
    .mockup-bar {
      background: var(--navy3);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      gap: 8px;
      border-bottom: 1px solid rgba(74,179,244,0.1);
    }
    .mockup-dot { width: 10px; height: 10px; border-radius: 50%; }
    .mockup-url {
      flex: 1;
      background: rgba(255,255,255,0.05);
      border-radius: 6px;
      padding: 4px 12px;
      font-size: 12px;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text2);
      text-align: center;
    }
    .mockup-body { padding: 1.5rem; }
    .mockup-topbar {
      background: var(--navy3);
      border-radius: 10px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    .mockup-logo { display: flex; align-items: center; gap: 8px; }
    .mockup-logo-icon { width: 28px; height: 28px; background: var(--blue); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; }
    .mockup-logo-text { font-size: 13px; font-weight: 600; color: var(--white); }
    .mockup-expiry { font-size: 11px; background: rgba(16,185,129,0.15); color: var(--green); padding: 3px 10px; border-radius: 99px; font-weight: 500; }
    .mockup-stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; margin-bottom: 1rem; }
    .mockup-stat { background: var(--navy3); border-radius: 8px; padding: 12px; }
    .mockup-stat-label { font-size: 10px; color: var(--text3); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
    .mockup-stat-val { font-size: 20px; font-weight: 700; }
    .mockup-table { background: var(--navy3); border-radius: 10px; overflow: hidden; }
    .mockup-table-head { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr; padding: 8px 12px; background: rgba(255,255,255,0.03); }
    .mockup-table-head span { font-size: 10px; color: var(--text3); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .mockup-row { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr; padding: 10px 12px; border-top: 1px solid rgba(255,255,255,0.04); align-items: center; }
    .mockup-row span { font-size: 12px; color: var(--text2); }
    .mockup-row .name { font-weight: 600; color: var(--white); }
    .mockup-badge { display: inline-block; font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 99px; }
    .mb-g { background: rgba(16,185,129,0.15); color: var(--green); }
    .mb-a { background: rgba(245,158,11,0.15); color: var(--amber); }
    .mb-r { background: rgba(239,68,68,0.15); color: var(--red); }
    .mockup-prog { height: 5px; background: rgba(255,255,255,0.08); border-radius: 99px; overflow: hidden; }
    .mockup-prog-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--blue), var(--cyan)); }

    /* ── SECTION ── */
    section { padding: 6rem 2rem; position: relative; }
    .container { max-width: 1100px; margin: 0 auto; }
    .section-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(30,107,196,0.12);
      border: 1px solid rgba(74,179,244,0.2);
      color: var(--blue2);
      padding: 5px 14px;
      border-radius: 99px;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 1rem;
      letter-spacing: 0.3px;
    }
    .section-title {
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 800;
      color: var(--white);
      letter-spacing: -1px;
      line-height: 1.1;
      margin-bottom: 1rem;
    }
    .section-title span { background: linear-gradient(135deg, var(--blue2), var(--cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .section-sub { font-size: 1.05rem; color: var(--text2); line-height: 1.7; max-width: 560px; }

    /* ── PROBLEMA ── */
    .problema-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-top: 3rem; }
    .problema-card {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 14px;
      padding: 1.75rem;
      transition: all .3s;
    }
    .problema-card:hover { background: rgba(255,255,255,0.04); border-color: rgba(74,179,244,0.15); transform: translateY(-4px); }
    .problema-icon { font-size: 2rem; margin-bottom: 1rem; }
    .problema-title { font-size: 16px; font-weight: 700; color: var(--white); margin-bottom: 8px; }
    .problema-text { font-size: 14px; color: var(--text2); line-height: 1.6; }

    /* ── FEATURES ── */
    .features-bg { background: rgba(10,22,40,0.5); border-top: 1px solid rgba(74,179,244,0.06); border-bottom: 1px solid rgba(74,179,244,0.06); }
    .features-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 2rem; margin-top: 3rem; }
    .feature-item { display: flex; gap: 1.25rem; }
    .feature-icon {
      width: 48px; height: 48px; flex-shrink: 0;
      background: rgba(30,107,196,0.15);
      border: 1px solid rgba(74,179,244,0.2);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px;
    }
    .feature-title { font-size: 16px; font-weight: 700; color: var(--white); margin-bottom: 6px; }
    .feature-text { font-size: 14px; color: var(--text2); line-height: 1.6; }

    /* ── COMO FUNCIONA ── */
    .steps { display: flex; flex-direction: column; gap: 0; margin-top: 3rem; position: relative; }
    .steps::before {
      content: '';
      position: absolute;
      left: 23px;
      top: 0; bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, var(--blue), transparent);
    }
    .step { display: flex; gap: 1.5rem; padding-bottom: 2.5rem; position: relative; }
    .step:last-child { padding-bottom: 0; }
    .step-num {
      width: 48px; height: 48px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--blue), var(--navy4));
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; font-weight: 800; color: var(--white);
      position: relative; z-index: 1;
      box-shadow: 0 0 20px rgba(30,107,196,0.4);
    }
    .step-title { font-size: 17px; font-weight: 700; color: var(--white); margin-bottom: 6px; }
    .step-text { font-size: 14px; color: var(--text2); line-height: 1.6; }

    /* ── PREÇOS ── */
    .precos-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 3rem; }
    .preco-card {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      padding: 2rem;
      position: relative;
      transition: all .3s;
    }
    .preco-card:hover { transform: translateY(-6px); }
    .preco-card.destaque {
      background: linear-gradient(135deg, rgba(30,107,196,0.15), rgba(74,179,244,0.08));
      border-color: rgba(74,179,244,0.3);
      box-shadow: 0 0 40px rgba(30,107,196,0.15);
    }
    .preco-popular {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(135deg, var(--blue), var(--cyan));
      color: var(--white);
      font-size: 11px;
      font-weight: 700;
      padding: 4px 14px;
      border-radius: 99px;
      letter-spacing: 0.5px;
      white-space: nowrap;
    }
    .preco-plano { font-size: 13px; font-weight: 600; color: var(--blue2); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px; }
    .preco-valor { display: flex; align-items: baseline; gap: 4px; margin-bottom: 6px; }
    .preco-rs { font-size: 18px; font-weight: 600; color: var(--text2); }
    .preco-num { font-size: 52px; font-weight: 800; color: var(--white); line-height: 1; }
    .preco-periodo { font-size: 14px; color: var(--text2); margin-bottom: 1.5rem; }
    .preco-divider { height: 1px; background: rgba(255,255,255,0.06); margin-bottom: 1.5rem; }
    .preco-items { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.75rem; }
    .preco-items li { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--text2); }
    .preco-items li::before { content: '✓'; color: var(--green); font-weight: 700; flex-shrink: 0; }
    .btn-preco {
      width: 100%;
      padding: 13px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      font-family: 'Sora', sans-serif;
      cursor: pointer;
      text-decoration: none;
      display: block;
      text-align: center;
      transition: all .2s;
      border: none;
    }
    .btn-preco-primary { background: linear-gradient(135deg, var(--blue), #1a5fa8); color: var(--white); box-shadow: 0 4px 20px rgba(30,107,196,0.3); }
    .btn-preco-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(30,107,196,0.5); }
    .btn-preco-outline { background: transparent; color: var(--text); border: 1px solid rgba(255,255,255,0.1); }
    .btn-preco-outline:hover { background: rgba(255,255,255,0.05); transform: translateY(-2px); }

    /* ── PRÓXIMO ── */
    .proximo-section {
      background: linear-gradient(135deg, rgba(10,22,40,0.8), rgba(15,37,64,0.6));
      border: 1px solid rgba(74,179,244,0.1);
      border-radius: 24px;
      padding: 4rem;
      display: flex;
      align-items: center;
      gap: 4rem;
      position: relative;
      overflow: hidden;
    }
    .proximo-section::before {
      content: '';
      position: absolute;
      right: -100px; top: -100px;
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(245,158,11,0.08) 0%, transparent 70%);
      pointer-events: none;
    }
    .proximo-badge { background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.3); color: var(--amber); padding: 5px 14px; border-radius: 99px; font-size: 12px; font-weight: 600; display: inline-block; margin-bottom: 1rem; }
    .proximo-title { font-size: 2rem; font-weight: 800; color: var(--white); letter-spacing: -1px; margin-bottom: 1rem; }
    .proximo-title span { color: var(--amber); }
    .proximo-text { font-size: 15px; color: var(--text2); line-height: 1.7; margin-bottom: 1.5rem; }
    .proximo-features { display: flex; flex-direction: column; gap: 8px; }
    .proximo-feature { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--text2); }
    .proximo-feature::before { content: '⚡'; flex-shrink: 0; }
    .proximo-img {
      flex-shrink: 0;
      width: 280px;
      background: var(--navy3);
      border: 1px solid rgba(245,158,11,0.2);
      border-radius: 16px;
      padding: 1.5rem;
    }
    .proximo-img-title { font-size: 14px; font-weight: 700; color: var(--amber); margin-bottom: 1rem; display: flex; align-items: center; gap: 8px; }
    .lance-item { display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .lance-item:last-child { border-bottom: none; }
    .lance-label { font-size: 12px; color: var(--text2); }
    .lance-val { font-size: 13px; font-weight: 700; color: var(--white); }
    .lance-badge { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 99px; background: rgba(245,158,11,0.15); color: var(--amber); }

    /* ── FAQ ── */
    .faq-list { margin-top: 3rem; display: flex; flex-direction: column; gap: 12px; }
    .faq-item {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      overflow: hidden;
    }
    .faq-question {
      padding: 1.25rem 1.5rem;
      font-size: 15px;
      font-weight: 600;
      color: var(--white);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      user-select: none;
      transition: background .2s;
    }
    .faq-question:hover { background: rgba(255,255,255,0.03); }
    .faq-question .faq-icon { color: var(--blue2); font-size: 18px; transition: transform .3s; flex-shrink: 0; }
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height .3s ease;
      font-size: 14px;
      color: var(--text2);
      line-height: 1.7;
    }
    .faq-answer-inner { padding: 0 1.5rem 1.25rem; }
    .faq-item.open .faq-answer { max-height: 200px; }
    .faq-item.open .faq-icon { transform: rotate(45deg); }

    /* ── CTA FINAL ── */
    .cta-final {
      text-align: center;
      padding: 8rem 2rem;
      position: relative;
      overflow: hidden;
    }
    .cta-final::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(30,107,196,0.12) 0%, transparent 70%);
    }
    .cta-final-content { position: relative; z-index: 1; }
    .cta-final h2 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; color: var(--white); letter-spacing: -1.5px; margin-bottom: 1rem; }
    .cta-final h2 span { background: linear-gradient(135deg, var(--blue2), var(--cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .cta-final p { font-size: 1.1rem; color: var(--text2); margin-bottom: 2.5rem; }
    .cta-final-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

